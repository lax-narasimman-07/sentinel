# SENTINEL Configuration

# Base directory for data, database, and workspaces
SENTINEL_BASE_DIR=~/.sentinel

# Rate limiting
SENTINEL_RATE_POLICY=normal          # Options: normal, aggressive, relaxed, stealth
SENTINEL_GLOBAL_RPS=10               # Global requests per second
SENTINEL_TARGET_RPS=5                # Per-target requests per second

# Execution
SENTINEL_SANDBOX=true                # Enable sandboxed execution
SENTINEL_REQUIRE_SCOPE=true          # Require scope validation before actions
SENTINEL_CTF_SKIP_SCOPE=true         # Skip scope checks in CTF mode

# Server
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8443
SENTINEL_AUTH_ENABLED=false          # Enable bearer token auth
SENTINEL_AUTH_TOKEN=                 # Bearer token (required if auth enabled)

# Browser automation
SENTINEL_BROWSER_ENABLED=false
SENTINEL_BROWSER_HEADLESS=true

# Logging
SENTINEL_LOG_LEVEL=INFO              # DEBUG, INFO, WARNING, ERROR, CRITICAL
