# OMEGA-CYBER-MCP Configuration

# Base directory for data, database, and workspaces
OMEGA_BASE_DIR=~/.omega

# Rate limiting
OMEGA_RATE_POLICY=normal          # Options: normal, aggressive, relaxed, stealth
OMEGA_GLOBAL_RPS=10               # Global requests per second
OMEGA_TARGET_RPS=5                # Per-target requests per second

# Execution
OMEGA_SANDBOX=true                # Enable sandboxed execution
OMEGA_REQUIRE_SCOPE=true          # Require scope validation before actions
OMEGA_CTF_SKIP_SCOPE=true         # Skip scope checks in CTF mode

# Server
OMEGA_HOST=127.0.0.1
OMEGA_PORT=8443
OMEGA_AUTH_ENABLED=false          # Enable bearer token auth
OMEGA_AUTH_TOKEN=                 # Bearer token (required if auth enabled)

# Browser automation
OMEGA_BROWSER_ENABLED=false
OMEGA_BROWSER_HEADLESS=true

# Logging
OMEGA_LOG_LEVEL=INFO              # DEBUG, INFO, WARNING, ERROR, CRITICAL
